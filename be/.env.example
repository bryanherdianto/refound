# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# AWS S3 - stores item images captured by the bin and uploaded by donors.
# The bucket must allow public reads; image URLs are returned to the frontend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=

# Google Gemini - item recognition and quality assessment
GEMINI_API_KEY=

# Clerk - used to verify admin JWTs on /api/admin/*
CLERK_SECRET_KEY=

# Origin allowed by CORS. Must match where the frontend is served from.
FRONTEND_URL=http://localhost:3000
